# Platform env (contoh) — JANGAN commit nilai asli

# PocketBase Platform (DB utama aplikasi)
POCKETBASE_PLATFORM_URL=
PB_ADMIN_EMAIL=
PB_ADMIN_PASSWORD=

# Master Hub (read-only catalog)
MASTER_HUB_URL=https://know.jioo.site
MASTER_HUB_TOKEN=
# Alias lama (opsional)
POCKETBASE_MASTER_URL=
POCKETBASE_SERVICE_TOKEN=

# Auth (Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=
PREVIEW_TOKEN_SECRET=
NEXTAUTH_URL=https://app.jioo.site
ALLOWED_ADMIN_EMAILS=
ADMIN_IP_ALLOWLIST=
JIOODEV_AUTH_MODE=real
# Hanya untuk staging: izinkan mock auth pada production build
JIOODEV_ALLOW_INSECURE_MOCK=0

# API mode untuk client ("mock" untuk demo tanpa backend)
NEXT_PUBLIC_API_MODE=real
NEXT_PUBLIC_API_BASE=/api

# QRIS (jika kosong, pembayaran manual diverifikasi admin)
QRIS_API_URL=
QRIS_BASE_URL=
QRIS_API_KEY=
QRIS_ENABLED=
QRIS_WEBHOOK_SECRET=

# Hermes runtime + callback
HERMES_JOB_URL=
HERMES_API_TOKEN=
HERMES_CALLBACK_SECRET=

# Deploy & domain
COOLIFY_DEPLOY_WEBHOOK=
DEPLOY_HEALTH_URL=
DOMAIN_CNAME_TARGET=cname.jioo.site
NEXT_PUBLIC_DOMAIN_CNAME_TARGET=cname.jioo.site
PLATFORM_DOMAIN=jioo.site
RESERVED_DOMAINS=
JIOODEV_LIBRARY_DIR=../library

# Notifikasi email (worker)
RESEND_API_KEY=
NOTIFY_FROM=no-reply@jioo.site

# SEO
SITE_URL=https://jioo.site

# Liveblocks (real-time collaboration)
# Get your public key from https://liveblocks.io dashboard
NEXT_PUBLIC_LIVEBLOCKS_PUBLIC_KEY=
# Server-side secret for API routes (optional, for REST auth)
LIVEBLOCKS_SECRET_KEY=

# Edge CDN (Cloudflare Workers + KV)
# Token needs "Account: Workers KV Storage: Edit" for the target account.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_KV_NAMESPACE_ID=

# Multi-server target (Phase 2+, R2 active in single-bucket mode)
# DATA_STORE=pb
# DATABASE_URL=
# R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# Single bucket (prefix-based public/private separation): set R2_BUCKET only.
# R2_BUCKET=object-storage-<suffix>
# Or two-bucket mode: set both R2_BUCKET_PUBLIC and R2_BUCKET_PRIVATE instead.
# R2_BUCKET_PUBLIC=jioo-cdn-public
# R2_BUCKET_PRIVATE=jioodev-storage-private
# R2_PUBLIC_BASE_URL=
# RATE_LIMIT_STORE=memory
# DEPLOY_HEALTH_TIMEOUT_MS=3000
